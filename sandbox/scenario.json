{
  "hosts": ["web", "app", "db", "workstation"],
  "ports": {"web": 8000},
  "services": {
    "web": {
      "service": "webapp",
      "version": "0.9-fake",
      "note": "admin page left open at /admin; its hint names the internal host 'app' and the service account 'svc-report'"
    },
    "app": {
      "service": "reportapi",
      "version": "1.0-fake",
      "note": "ships with a weak default sign-in; its config holds the db sign-in"
    },
    "db": {
      "service": "fakestore",
      "version": "1.2-fake",
      "note": "sign-in comes from the app config, not a vendor default"
    },
    "workstation": {
      "service": "desktop",
      "version": "3.1-fake",
      "note": "no planted weakness, used for lateral movement"
    }
  },
  "shipped_defaults": {
    "note": "documents the factory defaults baked into the images; the live values live in the containers and sign-in checks run there, never against this file",
    "app": {"user": "svc-report", "pass": "password"},
    "db": {"user": "dbops", "pass": "dbops-fake-19"}
  },
  "secret": {"host": "db", "path": "/secret/exercise_secret.txt"},
  "app_config": {"host": "app", "path": "/srv/app/config.ini"},
  "readable_roots": ["/secret/", "/srv/app/", "/srv/data/", "/srv/state/"],
  "admin_endpoint": {"host": "web", "path": "/admin"},
  "business_weights": {"web": 3, "app": 3, "db": 5, "workstation": 1},
  "blue_inventory": {
    "hosts": {
      "web": {"role": "public web front end", "connected_to": ["app", "db", "workstation"]},
      "app": {"role": "internal reporting service", "connected_to": ["web", "db", "workstation"]},
      "db": {"role": "internal data store", "connected_to": ["web", "app", "workstation"]},
      "workstation": {"role": "analyst workstation", "connected_to": ["web", "app", "db"]}
    },
    "crown_jewel_host": "db"
  }
}
