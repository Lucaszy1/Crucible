# Local secrets stay out of history. Copy .env.example to .env and fill it in.
.env

# Exercise output stays local, except the single sample kept for reference.
runs/*
!runs/.gitkeep
!runs/sample.jsonl

# Cached model responses, safe to delete at any time.
.llm_cache/

# Python runtime files.
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/
.pytest_cache/

# macOS metadata.
.DS_Store
