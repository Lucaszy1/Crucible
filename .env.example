# Copy this file to .env and fill in real values. Never commit .env.
MODEL_API_KEY=put-your-key-here

# Hard cap on estimated model spend per day, in USD.
LLM_DAILY_LIMIT_USD=5

# Reasoning effort sent to the model API. Default is low.
LLM_REASONING_EFFORT=low

# Optional. Only needed for the open-weights blue team variant.
BASETEN_API_KEY=

# Optional. Override the default Meta Model API base URL for tests.
# MODEL_API_BASE=https://api.meta.ai/v1
